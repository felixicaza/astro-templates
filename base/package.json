{
  "name": "astro-template",
  "version": "0.0.1",
  "description": "Template with performance and SEO configurations for Astro.",
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "astro check && astro build",
    "dev": "astro dev",
    "prepare": "simple-git-hooks",
    "preview": "astro preview",
    "start": "astro dev"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm nano-staged"
  },
  "nano-staged": {
    "*": "pnpm lint:fix"
  },
  "dependencies": {
    "@astrojs/check": "0.9.8",
    "@playform/compress": "0.2.2",
    "@playform/inline": "0.1.4",
    "@sardine/lightningcss-plugin-global-custom-queries": "1.1.0",
    "@unocss/reset": "66.6.7",
    "astro": "6.1.1",
    "astro-capo": "0.0.1",
    "astro-compressor": "1.3.0",
    "astro-iconify": "1.2.0",
    "astro-lqip": "1.8.0",
    "astro-seo-schema": "6.0.0",
    "astro-sitemap": "1.0.0",
    "lightningcss": "1.32.0",
    "schema-dts": "2.0.0",
    "sharp": "0.34.5",
    "typescript": "6.0.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@typescript-eslint/parser": "8.57.2",
    "eslint": "10.1.0",
    "eslint-plugin-astro": "1.6.0",
    "eslint-plugin-jsonc": "3.1.2",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-package-json": "0.91.0",
    "eslint-plugin-yml": "3.3.1",
    "globals": "17.4.0",
    "jiti": "2.6.1",
    "nano-staged": "0.9.0",
    "neostandard": "0.13.0",
    "simple-git-hooks": "2.13.1"
  }
}
