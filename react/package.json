    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@unocss/reset": "66.6.8",
    "astro": "6.1.5",
    "astro-capo": "0.0.1",
    "astro-compressor": "1.3.0",
    "astro-iconify": "1.3.1",
    "astro-lqip": "1.8.1",
    "astro-seo-schema": "6.0.0",
    "astro-sitemap": "1.0.0",
    "lightningcss": "1.32.0",
    "react": "19.1.1",
